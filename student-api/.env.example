# Copy this file to ".env" and change the values. NEVER commit ".env".
NODE_ENV=development
PORT=4000

# Matches docker-compose.yml (development password only).
DATABASE_URL=postgresql://onlinemart:onlinemart_dev_password@localhost:5432/onlinemart?schema=public

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins.
FRONTEND_ORIGIN=http://localhost:3000

# HMAC secret used to sign/verify the mock payment webhook (min 16 chars).
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-16+

# Central shipping policy (core scope: free).
SHIPPING_COST=0.00

# Set to true to simulate a gateway refund failure (tests the retry cron).
MOCK_REFUND_FAIL=false

# Used only by "npm run db:seed" (creates the single admin if none exists).
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe12345
